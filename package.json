{
  "name": "n-queens-simulator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "audit": "npm audit --audit-level=high",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --base=/NQueensSimulator/dev/",
    "quality": "npm run lint && npm run typecheck && npm test && npm run test:coverage && npm run audit && npm run build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
